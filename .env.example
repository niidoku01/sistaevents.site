# Copy to .env and fill in real values. NEVER commit .env.
# See SECURITY.md -> "Secret rotation" for where to generate these values.

VITE_API_URL="http://localhost:5000"
VITE_CONVEX_SITE_URL="https://your-deployment.convex.site"
VITE_CONVEX_URL="https://your-deployment.convex.cloud"

# Firebase web app config (get from Firebase console -> Project settings -> General)
# NOTE: rotate the API key after any public exposure, then restrict HTTP referrers.
VITE_FIREBASE_API_KEY="REPLACE_WITH_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="REPLACE_WITH_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="REPLACE_WITH_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="REPLACE_WITH_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="REPLACE_WITH_FIREBASE_APP_ID"

# NOTE: The Convex admin secret must NOT be set here.
# It is served server-side only, authenticated via /api/admin/convex-token.
# Set CONVEX_ADMIN_SECRET in the backend/server environment (e.g. Vercel) instead.