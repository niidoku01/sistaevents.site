# Copy to server/.env and fill in real values. NEVER commit server/.env.

# --- Convex admin secret (served to authenticated admins via /api/admin/convex-token) ---
CONVEX_ADMIN_SECRET=""

# --- Firebase Admin (used for /api/admin/convex-token and admin auth) ---
SERVICE_ACCOUNT_JSON_BASE64=""
FIREBASE_ADMIN_EMAILS=""
FRONTEND_URL="https://sistaevents.site"

# --- Cloudflare R2 (Collection image files) ---
# Variable names are "R2_*" but the values are Cloudflare R2 credentials:
#   R2_ACCOUNT_ID        -> Cloudflare Account ID
#   R2_ACCESS_KEY_ID     -> R2 API token access key id
#   R2_SECRET_ACCESS_KEY -> R2 API token secret
#   R2_BUCKET_NAME       -> bucket name (managed in R2 dashboard)
#   R2_PUBLIC_URL        -> public custom domain / r2.dev URL for the bucket
# Account ID from the right side of the R2 overview dashboard.
R2_ACCOUNT_ID=""
# API token: R2 -> Manage R2 API Tokens -> Create API token (Object Read & Write).
# Server-side ONLY. Never expose these to the client.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# The bucket that stores Collection images, e.g. sista-collections.
R2_BUCKET_NAME=""
# Public base URL for the bucket: a custom domain (e.g. https://r2.sistaevents.site)
# or the r2.dev public URL (https://pub-<id>.r2.dev). The bucket must be public
# or served through a custom domain so the Gallery can hotlink the images.
# No trailing slash.
R2_PUBLIC_URL=""
# Object layout on R2:
#   collections/{category}/{docId}.jpg            (migrated Convex images)
#   collections/{category}/{time}-{rand}.jpg      (new admin uploads)
# The browser uploads straight to R2 via a presigned PUT issued by this server,
# so the bucket must allow CORS PUT from the admin site (see Cloudflare docs).